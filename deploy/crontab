# Root's crontab on the droplet. Times are Central (the droplet's timezone).
# Install with `crontab deploy/crontab`; this replaces root's whole crontab.
#
# Refresh Strava data into Neon at 5pm and 11pm, then export every activity
# to Dropbox. The export only runs if the refresh succeeded.
0 17,23 * * * cd ~/strava-data-project && ~/.local/bin/uv run python strava_api_neon.py >> ~/cron.log 2>&1 && ~/bin/export_to_dropbox.sh >> ~/cron.log 2>&1
