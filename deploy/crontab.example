# Example crontab for a scheduled refresh. Replace the paths with your own and
# install with `crontab -e`. Times use the server's timezone. Cron runs with a
# minimal PATH, so give the full path to uv (`which uv`).
#
# Refresh Strava data into Neon at 5pm and 11pm. Everything the run prints,
# including errors from before the loader starts (such as a missing package),
# goes to logs/cron.log in the project folder. deploy/logrotate.example rotates it.
0 17,23 * * * cd ~/strava-data-project && mkdir -p logs && ~/.local/bin/uv run python strava_api.py >> logs/cron.log 2>&1
