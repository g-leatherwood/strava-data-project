# Example crontab for a scheduled refresh. Replace the paths with your own and
# install with `crontab -e`. Times use the server's timezone. Cron runs with a
# minimal PATH, so give the full path to uv (`which uv`).
#
# Refresh Strava data into Neon at 5pm and 11pm, then export every activity
# to Dropbox. The export only runs if the refresh succeeded.
0 17,23 * * * cd ~/strava-data-project && ~/.local/bin/uv run python strava_api.py >> ~/cron.log 2>&1 && ~/bin/export_to_dropbox.sh >> ~/cron.log 2>&1
